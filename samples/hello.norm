import ui.Button
import ui.Column
import ui.DesktopApp
import ui.Text
import ui.Widget
import ui.runApp

class Counter implements Widget {
  private Integer clicks = 0

  Widget build() {
    Column([
      Text("Clicks: ${clicks}"),
      Button("Click me") { clicks = clicks + 1 }
    ])
  }
}

Module module() {
  module(dependencies: [dependency(repository: "github", name: "ui", version: 5)])
}

Void main() {
  runApp(DesktopApp(title: "Norm UI", home: Counter()))
}
