package ui

import ui.fx.FxApplication
import di.Container
import di.startContainer
import std.core.Unit

value DesktopApp<C = Unit> {
  String title
  Widget home
  C? config = null
  Double width = 760.0
  Double height = 680.0

  Void run() {
    var configuration = this.config
    var container = if configuration == null { Container() } else { startContainer<C>(configuration) }
    try {
      runApp(title: title, body: (scope) { widgetView(home) }, container: container, width: width, height: height)
    } finally {
      container.close()
    }
  }
}

Void runApp<C>(DesktopApp<C> app) {
  app.run()
}

Void runApp(String title, Function<View(ViewScope)> body, Container? container = null, Double width = 760.0, Double height = 680.0) {
  var application = FxApplication(title: title, width: width, height: height)
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application), container: container)
  application.run(build: () {
    renderer.render(View(content: ViewContent.Component(type: "application", body: body)))
    application.root(fxHandle(renderer.node()))
  }, dispose: renderer.close)
}
