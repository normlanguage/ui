Module module() {
  return module(
    name: "ui",
    version: 4,
    exports: ["reactive", "scope", "view", "rendering", "application", "widgets", "widget", "foreach", "key", "tasks", "native", "javafx"],
    dependencies: [dependency(repository: "github", name: "ui.fx", version: 3), dependency(repository: "github", name: "di", version: 3)]
  )
}
