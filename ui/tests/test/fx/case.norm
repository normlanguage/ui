package ui.test.fx

import ui.test.extension.mixesAdoptedJavaFxNodesWithBuiltInNodesInARealWindow
import ui.NodeKey

import std.testing.Test
import ui.fx.FxApplication
import ui.fx.withFxRuntime
import ui.Renderer
import ui.JavaFxBackend
import ui.JavaFxScheduler
import ui.ViewScope
import std.core.Exception
import ui.ReactiveRuntime
import ui.State
import ui.View
import ui.ViewContent
import ui.fxHandle
import ui.Widget
import ui.Text
import ui.Button
import ui.Column
import ui.Row
import ui.Key
import ui.TextField
import ui.TextFieldHandle
import ui.Binding
import std.concurrent.async

class AsyncLifecyclePreview implements Widget {
  Function<Void()> completed
  Void init() {
    async { "初始化查询" }.then {
      require(condition: result == "初始化查询", message: "init task returns data")
      completed()
    }
  }
  Widget build() { Text("正在查询") }
}

Void startsAsyncFromARealComponentInitializer() {
  var application = FxApplication("Norm init async verification")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  application.run(build: () {
    renderer.render(AsyncLifecyclePreview(completed: () {
      application.root(fxHandle(renderer.node()))
      application.close()
    }))
    application.root(fxHandle(renderer.node()))
  }, dispose: () { renderer.close() })
}

Void deliversPublicAsyncFromAMountedComponentToJavaFx() {
  var application = FxApplication("Norm public async verification")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  application.run(build: () {
    renderer.render(View(content: ViewContent.Component(type: "async", body: (ViewScope scope) {
      async { "数据库任务结果" }.then {
        require(condition: result == "数据库任务结果", message: "typed public result")
        application.root(fxHandle(renderer.node()))
        async {}.then { application.close() }
      }
      View(content: ViewContent.Text("等待结果"))
    })))
    application.root(fxHandle(renderer.node()))
  }, dispose: () { renderer.close() })
}

class InputPreview implements Widget {
  private Key<TextFieldHandle> inputKey = Key<TextFieldHandle>()

  Widget build() {
    TextField(key: inputKey, placeholder: "添加任务", value: Binding<String>(read: () { "任务" }, write: (String next) {})) {}
  }

  Boolean mounted() { inputKey.current != null }
  Void focus() { inputKey.current?.focus() }
}

Void connectsAComponentOwnedKeyToARealInput() {
  var application = FxApplication("Norm typed Key verification")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  var preview = InputPreview()
  require(condition: !preview.mounted(), message: "component reference starts empty")
  application.run(build: () {
    renderer.render(preview)
    application.root(fxHandle(renderer.node()))
    require(condition: preview.mounted(), message: "component field receives the real input handle")
    application.later(() { preview.focus() application.close() })
  }, dispose: () { renderer.close() })
  require(condition: !preview.mounted(), message: "closing clears the component field reference")
}

value WidgetPreview implements Widget {
  Widget build() {
    Column([Text("待办清单"), Row([Text("组件对象"), Button(text: "添加") {}])])
  }
}

Void mountsWidgetObjectsInJavaFx() {
  var application = FxApplication("Norm Widget objects verification")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  application.run(build: () {
    renderer.render(WidgetPreview())
    application.root(fxHandle(renderer.node()))
    application.later(() { application.close() })
  }, dispose: () { renderer.close() })
}

Void mountsARealJavaFxTreeFromNormAndDisposesOnTheUiThread() {
  var application = FxApplication("Norm declarative GUI verification")
  var renderer = Renderer(JavaFxBackend(application))
  var runtime = ReactiveRuntime()
  var scope = ViewScope(runtime: runtime, scheduler: JavaFxScheduler(application))
  var title = State<String>(runtime: runtime, initial: "中文任务")
  application.run(build: () {
    renderer.render(View(content: ViewContent.Column([
      View(key: NodeKey.Named("heading"), content: ViewContent.Text("Norm GUI")),
      View(key: NodeKey.Named("title"), content: ViewContent.Input(placeholder: "任务标题", text: title.binding(), submit: (String text) {})),
      View(key: NodeKey.Named("action"), content: ViewContent.Button(text: "完成", action: () { title.value = ("已完成") }))
    ])))
    application.root(fxHandle(renderer.node()))
    scope.execute(() {
      async { "后台完成" }.then {
      require(condition: result == "后台完成", message: "scope delivers typed background result")
      renderer.render(View(content: ViewContent.Column([
        View(key: NodeKey.Named("action"), content: ViewContent.Button(text: "完成", action: () {})),
        View(key: NodeKey.Named("title"), content: ViewContent.Input(placeholder: "任务标题", text: title.binding(), submit: (String text) {}))
      ])))
      application.close()
      }
      return
    })
    return
  }, dispose: () {
    scope.close()
    renderer.close()
    runtime.close()
  })
}

Void preservesSelfManagedInputAcrossWidgetRebuilds() {
  var application = FxApplication("Norm self-managed input verification")
  var renderer = Renderer(backend: JavaFxBackend(application), scheduler: JavaFxScheduler(application))
  var key = Key<TextFieldHandle>()
  application.run(build: () {
    renderer.render(TextField(key: key, placeholder: "任务") { title in })
    application.root(fxHandle(renderer.node()))
    var peer = fxHandle(renderer.node())
    peer.text("中文任务")
    renderer.render(TextField(key: key, placeholder: "新提示") { title in })
    var input = key.current
    if input == null { throw Exception(message: "input handle missing") }
    require(condition: input.text == "中文任务", message: "rebuild preserves native editing buffer")
    input.clear()
    renderer.render(TextField(key: key, placeholder: "任务") { title in })
    require(condition: input.text == "", message: "rebuild does not resurrect cleared text")
    application.later(() { application.close() })
  }, dispose: () { renderer.close() })
  require(condition: key.current == null, message: "closing clears self-managed input reference")
}

@Test
Void verifiesJavaFxApplications() {
  withFxRuntime(() {
    mixesAdoptedJavaFxNodesWithBuiltInNodesInARealWindow()
    startsAsyncFromARealComponentInitializer()
    deliversPublicAsyncFromAMountedComponentToJavaFx()
    connectsAComponentOwnedKeyToARealInput()
    mountsWidgetObjectsInJavaFx()
    mountsARealJavaFxTreeFromNormAndDisposesOnTheUiThread()
    preservesSelfManagedInputAcrossWidgetRebuilds()
  })
}
