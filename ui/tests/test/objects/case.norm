package ui.test.objects

import std.testing.Test
import ui.Widget
import ui.ForEach
import ui.ValueKey
import std.annotation.IdentityField
import std.annotation.RuntimeRetention
import ui.Binding
import ui.WidgetRole
import ui.View
import ui.text
import ui.describeChildren
import ui.describe
import ui.componentCallback
import ui.componentBinding
import ui.ViewContent
import ui.RenderBackend
import ui.RenderNode
import ui.Renderer
import ui.ViewScope
import std.context.currentContext
import std.core.Exception
import std.observation.onChange

class SubscriptionSource { String title = "before" }

class SubscriptionWidget implements Widget {
  SubscriptionSource source
  Clicks clicks
  Boolean fail = false
  Void init() {
    var owner = currentContext<ViewScope>()
    source.title.onChange {
      require(condition: currentContext<ViewScope>() == owner && owner != null, message: "initializer subscription restores component context")
      clicks.count = clicks.count + 1
    }
    if fail { throw Exception(message: "subscription init failed") }
  }
  Widget build() { text("subscription") }
}

@Test
Void releasesInitializerSubscriptionsOnUnmountAndFailedInitialization() {
  var source = SubscriptionSource()
  var clicks = Clicks()
  var renderer = Renderer(Backend())
  renderer.render(SubscriptionWidget(source: source, clicks: clicks))
  source.title = "mounted"
  require(condition: clicks.count == 1, message: "mounted observer receives changes")
  renderer.render(text("replacement"))
  source.title = "unmounted"
  require(condition: clicks.count == 1, message: "unmount releases initializer subscription")
  var failed = false
  try { renderer.render(SubscriptionWidget(source: source, clicks: clicks, fail: true)) }
  catch Exception error { failed = error.message == "subscription init failed" }
  source.title = "failed"
  require(condition: failed && clicks.count == 1, message: "failed initialization releases subscription")
  renderer.close()
}

value SubmittedInputPreview implements Widget {
  Clicks clicks
  Widget build() {
    View(content: ViewContent.Input(placeholder: "任务", text: null, submit: componentCallback<String>((String title) {
      require(condition: title == "提交标题", message: "contract supplies String title")
      clicks.count = clicks.count + 1
    })))
  }
}

@Test
Void suppliesTheTextFieldSubmissionParameterFromItsContract() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var clicks = Clicks()
  renderer.render(SubmittedInputPreview(clicks: clicks))
  for node : backend.nodes {
    switch node.content {
      case Input(_, _, Function<Void(String)> submit) {
        submit("提交标题")
        require(condition: clicks.count == 1, message: "mounted callback executes exactly once")
        renderer.close()
        submit("提交标题")
        require(condition: clicks.count == 1, message: "unmounted callback is ignored")
      }
      case _ {}
    }
  }
  require(condition: clicks.count == 1, message: "contextual callback count ${clicks.count}, nodes ${backend.nodes.size()}")
  renderer.close()
}

value BoundInputPreview implements Widget {
  Clicks clicks
  Widget build() {
    var owner = currentContext<ViewScope>()
    View(content: ViewContent.Input(placeholder: "任务", text: componentBinding<String>(Binding<String>(read: () { "原始标题" }, write: (String next) {
      require(condition: currentContext<ViewScope>() == owner && owner != null, message: "editing restores component context")
      require(condition: next == "新标题", message: "editing delivers text")
      clicks.count = clicks.count + 1
    })), submit: (String text) {}))
  }
}

@Test
Void BindsTextEditingToComponentLifetime() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var clicks = Clicks()
  renderer.render(BoundInputPreview(clicks: clicks))
  for node : backend.nodes {
    switch node.content {
      case Input(_, Binding<String>? text, _) {
        if text != null {
          require(condition: text.value == "原始标题", message: "binding read is preserved")
          text.value = "新标题"
          renderer.close()
          text.value = "新标题"
        }
      }
      case _ {}
    }
  }
  require(condition: clicks.count == 1, message: "only mounted edit is delivered")
  renderer.close()
}

value TogglePreview implements Widget {
  Clicks clicks
  Widget build() {
    var owner = currentContext<ViewScope>()
    View(content: ViewContent.Toggle(text: "完成", checked: componentBinding<Boolean>(Binding<Boolean>(read: () { false }, write: (Boolean checked) {
      require(condition: currentContext<ViewScope>() == owner && owner != null, message: "toggle event restores owner")
      if checked { clicks.count = clicks.count + 1 }
    }))))
  }
}

@Test
Void deliversToggleValuesAndSuppressesUnmountedChanges() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var clicks = Clicks()
  renderer.render(TogglePreview(clicks: clicks))
  for node : backend.nodes {
    switch node.content {
      case Toggle(_, Binding<Boolean> checked) {
        require(condition: !checked.value, message: "configuration supplies initial checked state")
        checked.value = true
        require(condition: clicks.count == 1, message: "toggle delivers new boolean")
        renderer.close()
        checked.value = true
        require(condition: clicks.count == 1, message: "unmounted toggle does not deliver")
      }
      case _ {}
    }
  }
  require(condition: clicks.count == 1, message: "toggle was mounted")
  renderer.close()
}

class FailedLifecycleWidget implements Widget {
  LifecycleCounts counts
  Void init() { throw Exception(message: "initialization failed") }
  Widget build() { text("unreachable") }
  Void dispose() { counts.disposed = counts.disposed + 1 }
}

@Test
Void releasesResourcesWhenInitializationFails() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var counts = LifecycleCounts()
  var rejected = false
  try { renderer.render(FailedLifecycleWidget(counts: counts)) }
  catch Exception error { rejected = error.message == "initialization failed" }
  require(condition: rejected && counts.disposed == 1, message: "failed init unwinds lifecycle")
  for node : backend.nodes { require(condition: node.closed, message: "failed mount releases native peer") }
  renderer.close()
}

class LifecycleCounts { Integer initialized = 0 Integer built = 0 Integer disposed = 0 }

class LifecycleWidget implements Widget {
  LifecycleCounts counts
  Void init() {
    require(condition: currentContext<ViewScope>() != null, message: "init has component context")
    counts.initialized = counts.initialized + 1
  }
  Widget build() {
    require(condition: counts.initialized == 1, message: "init precedes build")
    counts.built = counts.built + 1
    text("生命周期")
  }
  Void dispose() {
    require(condition: currentContext<ViewScope>() != null, message: "dispose has component context")
    counts.disposed = counts.disposed + 1
  }
}

@Test
Void initializesAndDisposesMountedObjectsOnce() {
  var renderer = Renderer(Backend())
  var counts = LifecycleCounts()
  var widget = LifecycleWidget(counts: counts)
  renderer.render(widget)
  renderer.render(widget)
  require(condition: counts.initialized == 1 && counts.built >= 1, message: "rebuild does not initialize again")
  renderer.close()
  renderer.close()
  require(condition: counts.disposed == 1, message: "unmount disposes exactly once")
}

value ContextButton implements Widget {
  Clicks clicks
  Widget build() {
    var owner = currentContext<ViewScope>()
    require(condition: owner != null, message: "build has a component scope")
    actionView("context") {
      require(condition: currentContext<ViewScope>() == owner, message: "event restores build scope")
      clicks.count = clicks.count + 1
    }
  }
}

@Test
Void bindsObjectEventsToTheirMountedComponent() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var clicks = Clicks()
  renderer.render(ContextButton(clicks: clicks))
  for node : backend.nodes {
    switch node.content {
      case Button(_, Function<Void()> action) {
        action()
        require(condition: clicks.count == 1, message: "mounted action runs")
        renderer.close()
        action()
        require(condition: clicks.count == 1, message: "unmounted action is ignored")
      }
      case _ {}
    }
  }
  require(condition: currentContext<ViewScope>() == null, message: "render does not leak context")
  renderer.close()
}

class Clicks { Integer count = 0 }

class Node implements RenderNode {
  ViewContent content
  List<RenderNode> descendants = []
  Boolean closed = false
  Void update(View view) { content = view.content }
  Void children(List<RenderNode> children) { descendants = children }
  Void close() { closed = true }
}

class Backend implements RenderBackend {
  List<Node> nodes = []
  RenderNode create(ViewContent content) {
    var node = Node(content: content)
    nodes.add(node)
    node
  }
}

value TodoSummary implements Widget {
  Clicks clicks
  Widget build() {
    tree([
      text("待办清单"),
      line([
        for (title : ["第一项", "第二项"]) text(title),
        if (clicks.count == 0) actionView(text: "添加") { clicks.count = clicks.count + 1 }
      ]),
      scrollView(tree(children: [text("底部")], role: WidgetRole.Card))
    ])
  }
}

@Test
Void rendersWidgetObjectsAndInvokesTrailingActions() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var clicks = Clicks()
  renderer.render(TodoSummary(clicks: clicks))
  List<String> labels = []
  for node : backend.nodes {
    switch node.content {
      case Text(String text) { labels.add(text) }
      case Button(_, Function<Void()> action) { action() }
      case _ {}
    }
  }
  require(condition: labels == ["待办清单", "第一项", "第二项", "底部"], message: "object tree preserves collection order")
  require(condition: clicks.count == 1, message: "button invokes its trailing action")
  renderer.close()
  for node : backend.nodes { require(condition: node.closed, message: "object tree releases every node") }
}

class FieldCounter implements Widget {
  private Integer count = 0
  Widget build() {
    tree([text("count:${count}"), actionView("increment") { count = count + 1 }])
  }
}

@Test
Void rebuildsWhenAnObservedWidgetFieldChanges() {
  var backend = Backend()
  var renderer = Renderer(backend)
  renderer.render(FieldCounter())
  Node? label = null
  Function<Void()>? increment = null
  for node : backend.nodes {
    switch node.content {
      case Text(String text) { if text == "count:0" { label = node } }
      case Button(_, Function<Void()> action) { increment = action }
      case _ {}
    }
  }
  increment!!()
  var rendered = false
  switch label!!.content {
    case Text(String text) { rendered = text == "count:1" }
    case _ {}
  }
  require(condition: rendered, message: "ordinary widget fields rebuild without explicit render")
  renderer.close()
}

class ConfiguredCounter implements Widget {
  String title
  LifecycleCounts counts
  private Integer count = 0
  Void init() { counts.initialized = counts.initialized + 1 }
  Void dispose() { counts.disposed = counts.disposed + 1 }
  Widget build() { tree([text("${title}:${count}"), actionView("increment") { count = count + 1 }]) }
}

@Test
Void retainsStateAndLifecycleWhenPublicInputsChange() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var counts = LifecycleCounts()
  renderer.render(ConfiguredCounter(title: "old", counts: counts))
  Node? label = null
  Function<Void()>? increment = null
  for node : backend.nodes {
    switch node.content {
      case Text(_) { label = node }
      case Button(_, Function<Void()> action) { increment = action }
      case _ {}
    }
  }
  increment!!()
  renderer.render(ConfiguredCounter(title: "new", counts: counts))
  require(condition: counts.initialized == 1 && counts.disposed == 0, message: "same type retains lifecycle")
  require(condition: !label!!.closed, message: "same type retains rendered node")
  var updated = false
  switch label!!.content {
    case Text(String text) { updated = text == "new:1" }
    case _ {}
  }
  require(condition: updated, message: "public inputs update and private state remains")
  renderer.close()
  require(condition: counts.disposed == 1, message: "retained instance disposes once")
}

value ConfiguredLabel implements Widget {
  String title
  LifecycleCounts counts
  Void init() { counts.initialized = counts.initialized + 1 }
  Void dispose() { counts.disposed = counts.disposed + 1 }
  Widget build() { text(title) }
}

@Test
Void replacesValueConfigurationAndRemountsDifferentTypes() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var counts = LifecycleCounts()
  renderer.render(ConfiguredLabel(title: "old", counts: counts))
  Node? label = null
  for node : backend.nodes {
    switch node.content {
      case Text(_) { label = node }
      case _ {}
    }
  }
  renderer.render(ConfiguredLabel(title: "new", counts: counts))
  var updated = false
  switch label!!.content {
    case Text(String text) { updated = text == "new" }
    case _ {}
  }
  require(condition: updated && !label!!.closed && counts.initialized == 1, message: "value replacement retains mount")
  renderer.render(ConfiguredCounter(title: "counter", counts: counts))
  require(condition: label!!.closed && counts.initialized == 2 && counts.disposed == 1, message: "different type remounts")
  renderer.close()
  require(condition: counts.disposed == 2, message: "both lifecycles are released")
}

annotation RecordId implements IdentityField, RuntimeRetention {}
class ListRecord { @RecordId() Long id String title }

@Test
Void keepsItemStateWhenReloadedEntitiesAreReordered() {
  var backend = Backend()
  var renderer = Renderer(backend)
  var counts = LifecycleCounts()
  renderer.render(tree([ForEach(items: [ListRecord(id: 1, title: "first"), ListRecord(id: 2, title: "second")]) {
    ConfiguredCounter(title: task.title, counts: counts)
  }]))
  Node? firstLabel = null
  Function<Void()>? increment = null
  for node : backend.nodes {
    switch node.content {
      case Text(String text) { if text == "first:0" { firstLabel = node } }
      case Button(_, Function<Void()> action) { if increment == null { increment = action } }
      case _ {}
    }
  }
  increment!!()
  switch renderer.node() {
    case Node root {
      require(condition: root.descendants.size() == 2, message: "ForEach adds no layout wrapper")
      var first = root.descendants[0]
      renderer.render(tree([ForEach(items: [ListRecord(id: 2, title: "second new"), ListRecord(id: 1, title: "first new")]) {
        ConfiguredCounter(title: task.title, counts: counts)
      }]))
      require(condition: root.descendants[1] == first, message: "identity follows reordered entity")
    }
    case _ { require(condition: false, message: "recorded root") }
  }
  var retained = false
  switch firstLabel!!.content {
    case Text(String text) { retained = text == "first new:1" }
    case _ {}
  }
  require(condition: retained && counts.initialized == 2 && counts.disposed == 0, message: "reloaded entity retains edited state")
  renderer.render(tree([ForEach(items: [ListRecord(id: 2, title: "remaining")]) {
    ConfiguredCounter(title: task.title, counts: counts)
  }]))
  require(condition: counts.initialized == 2 && counts.disposed == 1 && firstLabel!!.closed, message: "removed item releases its state and node")
  increment!!()
  renderer.close()
  require(condition: counts.disposed == 2, message: "each retained item is disposed")
}

@Test
Void supportsExplicitTypedIdentitiesAndRejectsDuplicates() {
  var backend = Backend()
  var renderer = Renderer(backend)
  renderer.render(line([ForEach(items: ["a", "b"], identity: (String item) { ValueKey(item) }) { text(task) }]))
  var rejected = false
  try {
    renderer.render(line([ForEach(items: ["a", "a"], identity: (String item) { ValueKey(item) }) { text(task) }]))
  } catch Exception failure { rejected = true }
  require(condition: rejected, message: "duplicate typed identities are rejected")
  renderer.close()
}

class PendingRecord { @RecordId() Long? id = null }

@Test
Void requiresPersistedOrExplicitItemIdentity() {
  var renderer = Renderer(Backend())
  var missing = false
  try { renderer.render(tree([ForEach(items: [Clicks()]) { text("missing") }])) }
  catch Exception failure { missing = true }
  require(condition: missing, message: "missing identity metadata requires a selector")
  var pending = false
  try { renderer.render(tree([ForEach(items: [PendingRecord()]) { text("pending") }])) }
  catch Exception failure { pending = true }
  require(condition: pending, message: "null generated identities cannot alias")
  renderer.close()
}

class CollectionCounter implements Widget {
  private List<Integer> values = []
  private Map<String, Integer> index = Map<String, Integer>()
  Widget build() {
    tree([
      text("collections:${values.size()}:${index.size()}"),
      actionView("append") {
        values.add(1)
        index.put(key: "first", value: values.size())
      }
    ])
  }
}

@Test
Void rebuildsAfterInPlaceWidgetCollectionChanges() {
  var backend = Backend()
  var renderer = Renderer(backend)
  renderer.render(CollectionCounter())
  Node? label = null
  Function<Void()>? append = null
  for node : backend.nodes {
    switch node.content {
      case Text(String text) { if text == "collections:0:0" { label = node } }
      case Button(_, Function<Void()> action) { append = action }
      case _ {}
    }
  }
  append!!()
  var rendered = false
  switch label!!.content {
    case Text(String text) { rendered = text == "collections:1:1" }
    case _ {}
  }
  require(condition: rendered, message: "in-place List and Map edits rebuild the existing widget")
  renderer.close()
}

class CollectionSource {
  List<Integer> values = []
  Map<String, Integer> index = Map<String, Integer>()
}

class CollectionSubscriptionWidget implements Widget {
  CollectionSource source
  Clicks clicks
  Void init() {
    var owner = currentContext<ViewScope>()
    source.values.onChange {
      require(condition: currentContext<ViewScope>() == owner, message: "list callback restores scope")
      clicks.count = clicks.count + 1
    }
    source.index.onChange {
      require(condition: currentContext<ViewScope>() == owner, message: "map callback restores scope")
      clicks.count = clicks.count + 1
    }
  }
  Widget build() { text("collection subscriptions") }
}

@Test
Void releasesCollectionSubscriptionsWhenTheWidgetUnmounts() {
  var renderer = Renderer(Backend())
  var source = CollectionSource()
  var clicks = Clicks()
  renderer.render(CollectionSubscriptionWidget(source: source, clicks: clicks))
  source.values.add(1)
  source.index.put(key: "first", value: 1)
  require(condition: clicks.count == 2, message: "mounted collections report changes")
  renderer.render(text("replacement"))
  source.values.add(2)
  source.index.put(key: "second", value: 2)
  require(condition: clicks.count == 2, message: "unmounted collection subscriptions are released")
  renderer.close()
}

View tree(List<Widget> children, WidgetRole role = WidgetRole.Default) { View(content: ViewContent.Column(describeChildren(children)), role: role) }
View line(List<Widget> children) { View(content: ViewContent.Row(describeChildren(children))) }
View scrollView(Widget child) { View(content: ViewContent.Scroll(describe(child))) }
View actionView(String text, Function<Void()> action) { View(content: ViewContent.Button(text: text, action: componentCallback(action))) }
