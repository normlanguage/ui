package ui

import std.context.withContext
import std.io.Resource
import std.core.Exception
import di.Container
import ui.theme.Theme
import ui.theme.ThemeSource

private enum MountIdentity { Explicit(NodeKey value), Position(Integer value) }

class MountedView implements Resource {
  private RenderBackend backend
  private UiScheduler? scheduler
  private Container? container
  private ReactiveRuntime runtime
  private ViewScope scope
  private State<View> description
  private RenderNode peer
  private NodeKey? key
  private String kind
  private List<MountedView> descendants
  private Boolean closed
  private ViewReference? reference
  private Resource? connection
  private WidgetLifetime? lifecycle
  private UiContext context
  private ThemeSource? inheritedTheme
  private Resource? themeSubscription
  private UiConfiguration inheritedConfiguration
  private UiConfiguration? appliedConfiguration

  MountedView(RenderBackend backend, ReactiveRuntime runtime, View view, UiScheduler? scheduler = null, Container? container = null, ThemeSource? inheritedTheme = null, UiConfiguration inheritedConfiguration = UiConfiguration()) {
    this.backend = backend
    this.scheduler = scheduler
    this.container = container
    this.runtime = runtime
    context = UiContext(runtime: runtime)
    this.inheritedTheme = inheritedTheme
    this.inheritedConfiguration = inheritedConfiguration
    appliedConfiguration = null
    themeSubscription = null
    scope = withContext<UiContext, ViewScope>(value: context, action: () { ViewScope(runtime: runtime, scheduler: scheduler) })
    description = State<View>(runtime: runtime, initial: view)
    key = view.key
    kind = viewKind(view.content)
    descendants = []
    closed = false
    reference = null
    connection = null
    lifecycle = null
    context.source = resolveViewTheme(view: view, inherited: inheritedTheme)
    context.configuration.value = resolveViewConfiguration(view: view, inherited: inheritedConfiguration)
    var nativeBackend = backend
    var nativeScope = scope
    peer = switch view.content {
      case Native(NativeView native) {
        try { break nativeScope.within<RenderNode>(() { native.create(backend: nativeBackend, scope: nativeScope) }) }
        catch Exception failure { nativeScope.close() throw failure }
      }
      case _ { break backend.create(view.content) }
    }
    scope.own(peer)
    try {
      this.updateEnvironment(view)
      switch view.content {
        case WidgetObject(Widget widget) {
          var lifetime = WidgetLifetime(widget: widget, scope: scope, container: container)
          lifecycle = lifetime
          scope.own(lifetime)
          lifetime.initialize()
        }
        case _ {}
      }
      scope.own(runtime.observe(() { this.refresh() }))
    } catch Exception failure {
      this.close()
      throw failure
    }
  }

  Boolean accepts(View view) {
    var lifetime = lifecycle
    if lifetime != null {
      switch view.content {
        case WidgetObject(Widget widget) { if !lifetime.owns(widget) { return false } }
        case _ { return false }
      }
    }
    return key == view.key && kind == viewKind(view.content)
  }

  RenderNode node() { return peer }

  Void update(View view) {
    runtime.batch(() {
      switch view.content {
        case WidgetObject(Widget widget) { lifecycle!!.update(widget) }
        case _ {}
      }
      this.updateEnvironment(view)
      description.value = (view)
    })
  }

  private Void updateEnvironment(View view) {
    var previousSource = context.source
    var previousConfiguration = context.configuration.peek()
    this.configure(view)
    this.bindTheme(view)
    if previousSource == context.source && previousConfiguration == context.configuration.peek() { return }
    for child : descendants {
      child.inheritedTheme = context.source
      child.inheritedConfiguration = context.configuration.peek()
      child.updateEnvironment(child.description.peek())
    }
  }

  private Void configure(View view) {
    context.configuration.value = resolveViewConfiguration(view: view, inherited: inheritedConfiguration)
    if appliedConfiguration == context.configuration.peek() { return }
    switch peer {
      case ConfiguredRenderNode configured { configured.configure(context.configuration.peek()) }
      case _ {}
    }
    appliedConfiguration = context.configuration.peek()
  }

  private Void bindTheme(View view) {
    var source = resolveViewTheme(view: view, inherited: inheritedTheme)
    if context.source == source && (source == null || themeSubscription != null) { return }
    var previous = themeSubscription
    themeSubscription = null
    if previous != null { scope.release(previous) previous.close() }
    context.source = source
    var resolved = source
    if resolved == null {
      switch peer {
        case ThemedRenderNode themed { themed.theme(null) }
        case _ {}
      }
    } else {
      themeSubscription = scope.within<Resource>(() {
        var subscription = resolved.watch((Theme snapshot) {
          switch peer {
            case ThemedRenderNode themed { themed.theme(snapshot) }
            case _ {}
          }
          return
        })
        scope.release(subscription)
        scope.own(subscription)
        subscription
      })
    }
  }

  private Void refresh() {
    if closed { return }
    var view = description.value
    List<View> children = switch view.content {
      case Component(_, Function<View(ViewScope)> body) {
        break [scope.within<View>(() { body(scope) })]
      }
      case Native(NativeView native) { break scope.within<List<View>>(() { native.children(peer) }) }
      case WidgetObject(Widget widget) {
        break [scope.within<View>(() { widgetView(lifecycle!!.build()) })]
      }
      case _ { break [] }
    }
    Map<NodeKey, Boolean> keys = Map<>()
    for child : children {
      var childKey = child.key
      if childKey != null {
        if keys.containsKey(childKey) {
          throw Exception(message: "duplicate child key: " + keyText(childKey))
        }
        keys.put(key: childKey, value: true)
      }
    }
    peer.update(view)
    var nextReference = view.reference
    if reference != nextReference {
      Resource? attached = null
      if nextReference != null { attached = nextReference.connect(peer) }
      var previousConnection = connection
      connection = attached
      reference = nextReference
      if previousConnection != null { previousConnection.close() }
    }
    Map<MountIdentity, MountedView> previous = Map<>()
    Integer oldIndex = 0
    for child : descendants {
      var identity = mountIdentity(key: child.key, index: oldIndex)
      previous.put(key: identity, value: child)
      oldIndex = oldIndex + 1
    }
    List<MountedView> next = []
    List<RenderNode> nodes = []
    Map<MountIdentity, Boolean> retained = Map<>()
    Integer index = 0
    List<Resource> created = []
    try {
      for child : children {
        var identity = mountIdentity(key: child.key, index: index)
        MountedView? mounted = null
        if previous.containsKey(identity) {
          var candidate = previous[identity]
          if candidate.accepts(child) {
            mounted = candidate
            retained.put(key: identity, value: true)
            candidate.inheritedTheme = context.source
            candidate.inheritedConfiguration = context.configuration.peek()
            candidate.update(child)
          }
        }
        MountedView resolved = switch mounted {
          case MountedView existing { break existing }
          case _ {
            var fresh = MountedView(backend: backend, runtime: runtime, view: child, scheduler: scheduler, container: container, inheritedTheme: context.source, inheritedConfiguration: context.configuration.peek())
            created.add(fresh)
            break fresh
          }
        }
        next.add(resolved)
        nodes.add(resolved.node())
        index = index + 1
      }
      peer.children(nodes)
    } catch Exception failure {
      try { closeResources(created) } catch Exception cleanupFailure {}
      throw failure
    }
    descendants = next
    List<Resource> removed = []
    for entry : previous {
      if !retained.containsKey(entry.first) { removed.add(entry.second) }
    }
    closeResources(removed)
  }

  Void close() {
    if closed { return }
    closed = true
    List<Resource> owned = []
    for child : descendants { owned.add(child) }
    descendants = []
    themeSubscription = null
    owned.add(scope)
    var attached = connection
    connection = null
    reference = null
    if attached != null { owned.add(attached) }
    closeResources(owned)
  }
}

private MountIdentity mountIdentity(NodeKey? key, Integer index) {
  return switch key {
    case NodeKey explicit { break MountIdentity.Explicit(explicit) }
    case _ { break MountIdentity.Position(index) }
  }
}

String viewKind(ViewContent content) {
  return switch content {
    case Text(_) { break "text" }
    case Button(_, _) { break "button" }
    case Input(_, _, _) { break "input" }
    case Multiline(_, _, _, _) { break "multiline" }
    case Toggle(_, _) { break "toggle" }
    case Component(String type, _) { break "component:" + type }
    case Native(NativeView native) { break "native:" + native.kind() }
    case WidgetObject(_) { break "widget" }
  }
}

private ThemeSource? resolveViewTheme(View view, ThemeSource? inherited) {
  ThemeSource? source = inherited
  switch view.content {
    case Native(NativeView native) {
      switch native {
        case ThemeProvider provider { source = if provider.source != null { provider.source } else { inherited } }
        case _ {}
      }
    }
    case _ {}
  }
  return source
}


private UiConfiguration resolveViewConfiguration(View view, UiConfiguration inherited) {
  UiConfiguration configuration = inherited
  switch view.content {
    case Native(NativeView native) {
      switch native {
        case UiProvider provider { configuration = provider.configuration ?? inherited }
        case _ {}
      }
    }
    case _ {}
  }
  configuration
}
