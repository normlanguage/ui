package ui

import std.build.BuildWith
import std.build.ResultBuilder

class WidgetBuilder implements ResultBuilder<Widget, List<Widget>> {
  private List<Widget> children = []
  Void add(Widget value) { children.add(value) }
  List<Widget> finish() { children }
}

interface Widget {
  Void init() {}
  Widget build()
  Void dispose() {}
}

value Text implements NativeWidget {
  String text
  WidgetRole role

  Text(String text) { this.text = text role = WidgetRole.Default }
  Text(String text, WidgetRole role) { this.text = text this.role = role }

  View nativeView() { View(content: ViewContent.Text(text), role: role) }
}

value Button implements NativeWidget {
  String text
  Function<Void()> action
  WidgetRole role
  Boolean enabled

  Button(String text, Function<Void()> action, WidgetRole role = WidgetRole.Default, Boolean enabled = true) {
    this.text = text
    this.action = action
    this.role = role
    this.enabled = enabled
  }

  View nativeView() { View(content: ViewContent.Button(text: text, action: componentCallback(action)), role: role, enabled: enabled) }
}

value Column implements NativeWidget {
  List<Widget> children
  WidgetRole role
  Boolean enabled

  Column(@BuildWith(WidgetBuilder.class) Function<List<Widget>()> content, WidgetRole role = WidgetRole.Default, Boolean enabled = true) {
    children = content()
    this.role = role
    this.enabled = enabled
  }

  Column(List<Widget> children) { this.children = children role = WidgetRole.Default enabled = true }
  Column(List<Widget> children, WidgetRole role, Boolean enabled = true) {
    this.children = children
    this.role = role
    this.enabled = enabled
  }

  View nativeView() {
    View(content: ViewContent.Column(widgetViews(children)), role: role, enabled: enabled)
  }
}

value Row implements NativeWidget {
  List<Widget> children
  WidgetRole role

  Row(@BuildWith(WidgetBuilder.class) Function<List<Widget>()> content, WidgetRole role = WidgetRole.Default) {
    children = content()
    this.role = role
  }

  Row(List<Widget> children) { this.children = children role = WidgetRole.Default }
  Row(List<Widget> children, WidgetRole role) { this.children = children this.role = role }

  View nativeView() { View(content: ViewContent.Row(widgetViews(children)), role: role) }
}

value Scroll implements NativeWidget {
  Widget child
  View nativeView() { View(content: ViewContent.Scroll(widgetView(child))) }
}

value TextField implements NativeWidget {
  String placeholder
  Binding<String>? value
  Function<Void(String)> submit
  Key<TextFieldHandle>? key
  WidgetRole role

  TextField(String placeholder, Void submit(String title), Key<TextFieldHandle>? key = null, WidgetRole role = WidgetRole.Default) {
    this.placeholder = placeholder
    value = null
    this.submit = submit
    this.key = key
    this.role = role
  }

  TextField(String placeholder, Binding<String> value, Function<Void()> submit, Key<TextFieldHandle>? key = null, WidgetRole role = WidgetRole.Default) {
    this.placeholder = placeholder
    this.value = value
    this.submit = (String text) { submit() }
    this.key = key
    this.role = role
  }

  View nativeView() {
    var target = key
    var source = value
    View(content: ViewContent.Input(placeholder: placeholder, text: if source != null { componentBinding<String>(source) } else { null }, submit: componentCallback<String>(submit)), role: role,
      reference: if target != null { TextFieldReference(target) } else { null })
  }
}

value Toggle implements NativeWidget {
  String text
  Binding<Boolean> value
  WidgetRole role
  Boolean enabled

  Toggle(String text, Boolean checked, Function<Void(Boolean)> changed, WidgetRole role = WidgetRole.Default, Boolean enabled = true) {
    this.text = text
    value = Binding<Boolean>(read: () { checked }, write: changed)
    this.role = role
    this.enabled = enabled
  }

  Toggle(String text, Binding<Boolean> value, WidgetRole role = WidgetRole.Default, Boolean enabled = true) {
    this.text = text
    this.value = value
    this.role = role
    this.enabled = enabled
  }

  View nativeView() { View(content: ViewContent.Toggle(text: text, checked: componentBinding<Boolean>(value)), role: role, enabled: enabled) }
}
